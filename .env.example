NODE_ENV=development
HOST=127.0.0.1
PORT=5000
BASE_URL=http://127.0.0.1:5000
CORS_ORIGIN=*

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=

# Auth
JWT_SECRET=YOUR-SECRET_HERE
JWT_EXPIRES_IN=1d

OTP_EXPIRY_MINUTES=10

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_USER_MAIL_HERE
SMTP_PASS=YOUR_PASSWORD_HERE
SMTP_FROM=YOUR_USER_MAIL_HERE

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Redis (required for BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe (fill in when setting up payments in Task 5)
STRIPE_SECRET_KEY=YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_KEY_HERE

# Real Stripe Price IDs (created by setup script)
STRIPE_PRICE_1M=STRIPE_PRICE_ID
STRIPE_PRICE_3M=STRIPE_PRICE_ID
STRIPE_PRICE_6M=STRIPE_PRICE_ID
STRIPE_PRICE_1Y=STRIPE_PRICE_ID
# Livekit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY_HERE
LIVEKIT_API_SECRET=YOUR_API_SECRET_HERE

# Gemini (Google Generative AI) — transcript summaries
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram — live Speech-to-Text (transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Local speech-to-text (whisper.cpp) for live transcription.
# Download the whisper.cpp Windows binary + a ggml model into tools/whisper.
WHISPER_BIN=tools/whisper/bin/Release/whisper-cli.exe
WHISPER_MODEL=tools/whisper/models/ggml-base.en.bin
WHISPER_THREADS=4
